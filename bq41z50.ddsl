// Optional compiler flag (disabled): --rust-defmt-feature=defmt-03
device Device {
    default-byte-order: LE,
    register-address-type: u8,
    command-address-type: u32,
    buffer-address-type: u8,
    word-boundaries: "_:-: :bB:A1:1A:1a:a1:AAa",
    default-access: RW,

    extern ErrorCode -> u8 {
        size-bits: 4,
        infallible: allow,
    },

    /// The device can be checked for the IC part number.

    command MAC_DEVICE_TYPE {
        address: 0x440100,
        fields-out: fieldset MAC_DEVICE_TYPEFieldsOut {
            size-bytes: 2,

            field DEVICE_TYPE 15:0 -> uint,
        },
    },
    /// The device can be checked for the firmware version of the IC.

    command MAC_FIRMWARE_VERSION {
        address: 0x440200,
        fields-out: fieldset MAC_FIRMWARE_VERSIONFieldsOut {
            size-bytes: 11,

            field DEVICE_NUMBER 15:0 -> uint,
            field VERSION 31:16 -> uint,
            field BUILD_NUMBER 47:32 -> uint,
            field FIRMWARE_TYPE 55:48 -> uint,
            field IMPEDENCE_TRACK_VERS 71:56 -> uint,
        },
    },

    command MAC_HARDWARE_VERSION {
        address: 0x440300,
        fields-out: fieldset MAC_HARDWARE_VERSIONFieldsOut {
            size-bytes: 1,

            field HW_VERS 7:0 -> uint,
        },
    },

    command MAC_INSTRUCTION_FLASH_SIGNATURE {
        address: 0x440400,
        fields-out: fieldset MAC_INSTRUCTION_FLASH_SIGNATUREFieldsOut {
            size-bytes: 1,

            field INSN_FLSH_SIG 7:0 -> uint,
        },
    },

    command MAC_STATIC_DF_SIGNATURE {
        address: 0x440500,
        fields-out: fieldset MAC_STATIC_DF_SIGNATUREFieldsOut {
            size-bytes: 2,

            field STATIC_DF_SIG 14:0 -> uint,
            field SIG_MISMATCH 15 -> bool,
        },
    },

    command MAC_CHEM_ID {
        address: 0x440600,
        fields-out: fieldset MAC_CHEM_IDFieldsOut {
            size-bytes: 2,

            field CHEM_ID 15:0 -> uint,
        },
    },

    command MAC_STATIC_CHEM_DF_SIG {
        address: 0x440800,
        fields-out: fieldset MAC_STATIC_CHEM_DF_SIGFieldsOut {
            size-bytes: 2,

            field STATIC_CHEM_DF_SIG 14:0 -> uint,
            field SIG_MISMATCH 15 -> bool,
        },
    },

    command MAC_ALL_DF_SIGNATURE {
        address: 0x440900,
        fields-out: MAC_STATIC_CHEM_DF_SIGFieldsOut,
    },

    command MAC_SHUTDOWN_MODE {
        address: 0x441000,
    },

    command MAC_SLEEP_MODE {
        address: 0x441100,
    },

    command MAC_AUTO_CC_OFFSET {
        address: 0x441300,
    },

    command MAC_FUSE_TOGGLE {
        address: 0x441D00,
    },

    command MAC_PCHG_FET_TOGGLE {
        address: 0x441E00,
    },

    command MAC_CHG_FET_TOGGLE {
        address: 0x441F00,
    },

    command MAC_DSG_FET_TOGGLE {
        address: 0x442000,
    },
    /// This command enables or disables the gauging function to ease
    /// testing during manufacturing.

    command MAC_GAUGING {
        address: 0x442100,
    },

    command MAC_FET_CTRL {
        address: 0x442200,
    },

    command MAC_LIFETIME_DATA_COLLECTION {
        address: 0x442300,
    },

    command MAC_PERMANENT_FAILURE {
        address: 0x442400,
    },

    command MAC_BLACK_BLOCK_RECORDER {
        address: 0x442500,
    },

    command MAC_FUSE {
        address: 0x442600,
    },

    command MAC_LED_DISP_EN {
        address: 0x442700,
    },

    command MAC_LIFETIME_DATA_RST {
        address: 0x442800,
    },

    command MAC_PF_DATA_RST {
        address: 0x442900,
    },

    command MAC_BLK_BOX_REC_RESET {
        address: 0x442A00,
    },

    command MAC_LED_TOGGLE {
        address: 0x442B00,
    },

    command MAC_LED_DISP_PRESS {
        address: 0x442C00,
    },

    command MAC_CALIBRATION_MODE {
        address: 0x442D00,
    },

    command MAC_LIFETIME_DATA_FLUSH {
        address: 0x442E00,
    },

    command MAC_LIFETIME_DATA_SPEED_UP_MODE {
        address: 0x442F00,
    },

    command MAC_SEAL {
        address: 0x443000,
    },

    command MAC_DEVICE_RESET {
        address: 0x444100,
    },

    command MAC_SAFETY_ALERT {
        address: 0x445000,
        fields-out: fieldset MAC_SAFETY_ALERTFieldsOut {
            size-bytes: 4,

            field CUV 0 -> bool,
            field COV 1 -> bool,
            field OCC1 2 -> bool,
            field OCC2 3 -> bool,
            field OCD1 4 -> bool,
            field OCD2 5 -> bool,
            field AOCDL 7 -> bool,
            field AOCCL 9 -> bool,
            field ASCDL 11 -> bool,
            field OTC 12 -> bool,
            field OTD 13 -> bool,
            field CUVC 14 -> bool,
            field DCOT 15 -> bool,
            field OTF 16 -> bool,
            field PTO 18 -> bool,
            field PTOS 19 -> bool,
            field CTO 20 -> bool,
            field CTOS 21 -> bool,
            field OC 22 -> bool,
            field CHGC 23 -> bool,
            field CHGV 24 -> bool,
            field PCHGC 25 -> bool,
            field UTC 26 -> bool,
            field UTD 27 -> bool,
            field COVL 28 -> bool,
            field OCDL 29 -> bool,
        },
    },

    command MAC_SAFETY_STATUS {
        address: 0x445100,
        fields-out: fieldset MAC_SAFETY_STATUSFieldsOut {
            size-bytes: 4,

            field CUV 0 -> bool,
            field COV 1 -> bool,
            field OCC1 2 -> bool,
            field OCC2 3 -> bool,
            field OCD1 4 -> bool,
            field OCD2 5 -> bool,
            field AOCD 6 -> bool,
            field AOCDL 7 -> bool,
            field AOCC 8 -> bool,
            field AOCCL 9 -> bool,
            field ASCD 10 -> bool,
            field ASCDL 11 -> bool,
            field OTC 12 -> bool,
            field OTD 13 -> bool,
            field CUVC 14 -> bool,
            field DCOT 15 -> bool,
            field OTF 16 -> bool,
            field HWDF 17 -> bool,
            field PTO 18 -> bool,
            field CTO 20 -> bool,
            field OC 22 -> bool,
            field CHGC 23 -> bool,
            field CHGV 24 -> bool,
            field PCHGC 25 -> bool,
            field UTC 26 -> bool,
            field UTD 27 -> bool,
            field COVL 28 -> bool,
            field OCDL 29 -> bool,
        },
    },

    command MAC_PF_ALERT {
        address: 0x445200,
        fields-out: fieldset MAC_PF_ALERTFieldsOut {
            size-bytes: 4,

            field SUV 0 -> bool,
            field SOV 1 -> bool,
            field SOCC 2 -> bool,
            field SOCD 3 -> bool,
            field SOT 4 -> bool,
            field SOTF 6 -> bool,
            field QIM 7 -> bool,
            field CB 8 -> bool,
            field IMP 9 -> bool,
            field CD 10 -> bool,
            field VIMR 11 -> bool,
            field VIMA 12 -> bool,
            field AOCDL 13 -> bool,
            field AOCCL 14 -> bool,
            field ASCDL 15 -> bool,
            field CFETF 16 -> bool,
            field DFETF 17 -> bool,
            field OCDL 18 -> bool,
            field FUSE 19 -> bool,
            field AFER 20 -> bool,
            field AFEC 21 -> bool,
            field SECOND_LVL 22 -> bool,
            field TMPC 27 -> bool,
            field TS1 28 -> bool,
            field TS2 29 -> bool,
            field TS3 30 -> bool,
            field TS4 31 -> bool,
        },
    },

    command MAC_PF_STATUS {
        address: 0x445300,
        fields-out: fieldset MAC_PF_STATUSFieldsOut {
            size-bytes: 4,

            field SUV 0 -> bool,
            field SOV 1 -> bool,
            field SOCC 2 -> bool,
            field SOCD 3 -> bool,
            field SOT 4 -> bool,
            field COVL 5 -> bool,
            field SOTF 6 -> bool,
            field QIM 7 -> bool,
            field CB 8 -> bool,
            field IMP 9 -> bool,
            field CD 10 -> bool,
            field VIMR 11 -> bool,
            field VIMA 12 -> bool,
            field AOCDL 13 -> bool,
            field AOCCL 14 -> bool,
            field ASCDL 15 -> bool,
            field CFETF 16 -> bool,
            field DFETF 17 -> bool,
            field OCDL 18 -> bool,
            field FUSE 19 -> bool,
            field AFER 20 -> bool,
            field AFEC 21 -> bool,
            // TODO FIX (retained from the YAML).
            field SECOND_LVL 22 -> bool,
            field TMPC 27 -> bool,
            field TS1 28 -> bool,
            field TS2 29 -> bool,
            field TS3 30 -> bool,
            field TS4 31 -> bool,
        },
    },

    command MAC_OPERATION_STATUS {
        address: 0x445400,
        fields-out: fieldset MAC_OPERATION_STATUSFieldsOut {
            size-bytes: 4,

            field PRES 0 -> bool,
            field DSG 1 -> bool,
            field CHG 2 -> bool,
            field PCHG 3 -> bool,
            field ACTHR 4 -> bool,
            field FUSE 5 -> bool,
            field EMSHUT 6 -> bool,
            field BTP_INT 7 -> bool,
