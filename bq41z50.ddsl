                Reserved: 0,
                FullAccess: 1,
                UnSealed: 2,
                Sealed: 3,
            },
            field SDV 10 -> bool,
            field SS 11 -> bool,
            field PF 12 -> bool,
            field XDSG 13 -> bool,
            field XCHG 14 -> bool,
            field SLEEP 15 -> bool,
            field SDM 16 -> bool,
            field LED 17 -> bool,
            field AUTH 18 -> bool,
            field AUTOCALM 19 -> bool,
            field CAL 20 -> bool,
            field CAL_OFFSET 21 -> bool,
